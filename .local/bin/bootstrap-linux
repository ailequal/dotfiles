#!/usr/bin/env bash

###################
# bootstrap-linux #
###################

set -euo pipefail

# update os && upgrade os
sudo apt-get -y update && sudo apt-get -y upgrade && sudo apt-get -y autoremove

# apt
apt_packages=(
  build-essential
  # chafa
  cloc
  curl
  fastfetch
  ffmpeg
  fzf
  gimp
  git
  gnome-shell-extensions
  gnome-shell-extension-manager
  # gnome-tweaks
  gpg
  handbrake
  htop
  inetutils-traceroute
  iperf3
  lm-sensors
  lolcat
  lsof
  make
  mpv
  net-tools
  nmap
  openssl
  pipx
  pngquant
  python3
  python-is-python3
  python3-dev
  python3-pip
  python3-venv
  ripgrep
  shellcheck
  software-properties-gtk
  speedtest-cli
  sqlite3
  s-tui
  tar
  tig
  # tmate
  tmux
  tree
  vim
  vlc
  wavemon
  wl-clipboard
)
sudo apt-get -y install "${apt_packages[@]}"

# snap
snap_packages=(
  0ad
  bruno
  slack
  spotify
  telegram-desktop
)
sudo snap install "${snap_packages[@]}"

# snap (classic confinement)
snap_classic_packages=(
  code
)
sudo snap install --classic "${snap_classic_packages[@]}"
